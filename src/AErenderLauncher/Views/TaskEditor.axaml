<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:AErenderLauncher.Controls"
        xmlns:rendering="clr-namespace:AErenderLauncher.Classes.Rendering"
        xmlns:vm="clr-namespace:AErenderLauncher.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AErenderLauncher.Views.TaskEditor"
        x:Name="TaskEditorView"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="Full"
        ExtendClientAreaChromeHints="{OnPlatform macOS='PreferSystemChrome', Windows='NoChrome'}"
        ExtendClientAreaTitleBarHeightHint="-1"
        ExtendClientAreaToDecorationsHint="True"
        Width="640" Height="450"
        Title="Task Editor"
        x:DataType="vm:TaskEditorViewModel"
        Loaded="Control_OnLoaded">
    <Design.DataContext>
        <vm:TaskEditorViewModel />
    </Design.DataContext>
    
    <Grid x:Name="Root" RowDefinitions="Auto,*">
        <controls:TitleBar Grid.Row="0" Title="Edit task">
            <controls:TitleBar.Toolbar>
                <Carousel Grid.Column="1" 
                          SelectedIndex="{Binding SelectedIndex, ElementName=EditorCarousel}" 
                          AutoScrollToSelectedItem="False">
                    <Grid ColumnDefinitions="Auto,Auto,*">
                        <Label Grid.Column="0" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" 
                               HorizontalAlignment="Center" Content="Project setup" Margin="16 0 0 0" />
                        <Label Grid.Column="1" Content="Project file path" VerticalAlignment="Center" 
                               Margin="64 0 0 0" />
                        <TextBox Grid.Column="2" x:Name="ProjectPath" HorizontalAlignment="Stretch" 
                                 Margin="4 4 8 4" IsReadOnly="True" 
                                 Text="{Binding ProjectPath}" />
                    </Grid>
                    
                    <Grid ColumnDefinitions="Auto,*,Auto,128">
                        <Label Grid.Column="0" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" 
                               HorizontalAlignment="Center" Content="Compositions" 
                               Margin="16 0 0 0" />
                    </Grid>
                </Carousel>
            </controls:TitleBar.Toolbar>    
        </controls:TitleBar>
        
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
            <Carousel Grid.Column="1" x:Name="EditorCarousel" SelectedIndex="0" AutoScrollToSelectedItem="False">
                <Grid RowDefinitions="*,32">
                    <StackPanel Grid.Row="0" Margin="8 0">
                        <Grid ColumnDefinitions="128,*,96" Height="32">
                            <Label Grid.Column="0" Content="Output file path:" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="OutputPath" HorizontalAlignment="Stretch" Margin="16 4 0 4" 
                                     Text="{Binding OutputPath}" />
                            <Button Grid.Column="2" x:Name="OutputPathButton" Content="Select file..." Margin="4 4 0 4" 
                                    HorizontalAlignment="Stretch" Click="OutputPathButton_OnClick"/>
                        </Grid>
                        
                        <Grid ColumnDefinitions="128,*" Height="32">
                             <Label Grid.Column="0" Content="Output Module Preset:" VerticalAlignment="Center" />
                             <ComboBox Grid.Column="1" x:Name="OutputModuleBox"  HorizontalAlignment="Stretch" Margin="16 4 0 4" 
                                       ItemsSource="{Binding OutputModules}" 
                                       SelectedIndex="{Binding SelectedOutputModule}">
                                 <ComboBox.ItemTemplate>
                                     <DataTemplate x:DataType="rendering:OutputModule">
                                         <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                     </DataTemplate>
                                 </ComboBox.ItemTemplate>
                             </ComboBox>
                        </Grid>
                        
                        <Grid ColumnDefinitions="128,*" Height="32">
                            <Label Grid.Column="0" Content="Render Settings:" VerticalAlignment="Center" />
                            <controls:ComboEdit Grid.Column="1" x:Name="RenderSettings"  HorizontalAlignment="Stretch" Margin="16 4 0 4" 
                                      ItemsSource="{Binding RenderSettingsPresets}" 
                                      Text="{Binding RenderSettings}" />
                        </Grid>
                        
                        <Border BorderThickness="1" BorderBrush="#151515">
                            <Grid RowDefinitions="Auto, *" ColumnDefinitions="0.5*, 0.5*">
                                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="8 4" Text="Properties" />
                                <Rectangle Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Height="1" Margin="0" Fill="#151515"/>
                                
                                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4" Margin="4">
                                    <CheckBox x:Name="MissingCheckbox" Content="Render with missing files" 
                                              IsChecked="{Binding MissingFiles}" />
                                    <CheckBox x:Name="SoundCheckbox" Content="Play sound when render finishes" 
                                              IsChecked="{Binding Sound}" />
                                    <CheckBox x:Name="ThreadedCheckbox" Content="Enable CPU Multithreading" 
                                              IsChecked="{Binding Multiprocessing}" />
                                </StackPanel>
                                
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="4" Spacing="4">
                                    <CheckBox x:Name="CustomCheckbox" Content="Custom properties" 
                                              IsChecked="{Binding CustomPropertiesEnabled}" />
                                    <TextBox x:Name="CustomProperties" 
                                             IsEnabled="{Binding ElementName=CustomCheckbox, Path=IsChecked}" 
                                             Text="{Binding CustomProperties}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        
                        <Grid ColumnDefinitions="128,*,128" Margin="0 4 0 0">
                            <Label Grid.Column="0" Content="Cache usage limit" VerticalAlignment="Center" />
                            <Slider x:Name="CacheSlider" Grid.Column="1" Minimum="1" Maximum="100" 
                                    Value="{Binding CacheLimit}" 
                                    Ticks="0,25,50,75,100" TickPlacement="None" />
                            <controls:EditTextBlock x:Name="CacheTextBlock" Grid.Column="2" TextAlignment="Right"
                                                    Text="{Binding CacheLimitString}" 
                                                    Submit="CacheTextBlock_OnSubmit"/>
                        </Grid>
                        
                        <Grid ColumnDefinitions="128,*,128" Margin="0 4 0 0">
                            <Label Grid.Column="0" Content="Memory usage limit" VerticalAlignment="Center" />
                            <Slider x:Name="MemorySlider" Grid.Column="1" Minimum="1" Maximum="100" 
                                    Value="{Binding MemoryLimit}" 
                                    Ticks="{Binding MemoryTickMarks}"
                                    TickPlacement="None"/>
                            <controls:EditTextBlock x:Name="MemoryTextBlock" Grid.Column="2" TextAlignment="Right" 
                                                    Text="{Binding MemoryLimitString}" 
                                                    Submit="MemoryTextBlock_OnSubmit"/>
                        </Grid>
                    </StackPanel>
                    
                    <Border Grid.Row="1" Classes="Statusbar">
                        <Grid Margin="4">
                            <Button Content="Cancel" HorizontalAlignment="Left" Click="CancelButton_OnClick"/>
                            <Button Content="Compositions &gt;&gt;" HorizontalAlignment="Right" Click="CompositionsButton_OnClick"/>
                        </Grid>
                    </Border>
                </Grid>
                
                <Grid RowDefinitions="*,32">
                    <Grid Grid.Row="0" RowDefinitions="*,32">
                        <ListBox Grid.Row="0" x:Name="CompList" SelectionMode="Single" 
                                 ItemsSource="{Binding Compositions}" 
                                 Classes="Filled" SelectionChanged="CompList_SelectionChanged" 
                                 Margin="4 4 4 0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="rendering:Composition">
                                    <Grid ColumnDefinitions="*,96,96,96">
                                        <TextBlock Grid.Column="0" Text="{Binding CompositionName}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Frames.StartFrame}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Frames.EndFrame}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Split}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Grid Grid.Row="1" ColumnDefinitions="64,*,96,96,64,64" Margin="4">
                            <Button Grid.Column="0" Margin="0 0 4 0" Content="+" Click="AddComp_OnClick"/>
                            <TextBox Grid.Column="1" Margin="0 0 4 0" x:Name="CompName" Watermark="Composition name" TextChanged="CompName_OnTextChanged"/>
                            <TextBox Grid.Column="2" Margin="0 0 4 0" x:Name="StartFrame"  Watermark="Start frame" TextChanged="StartFrame_OnTextChanged"/>
                            <TextBox Grid.Column="3" Margin="0 0 4 0" x:Name="EndFrame" Watermark="End frame" TextChanged="EndFrame_OnTextChanged"/>
                            <TextBox Grid.Column="4" Margin="0 0 4 0" x:Name="Split" Watermark="Split" TextChanged="Split_OnTextChanged"/>
                            <Button Grid.Column="5" Content="Remove" Click="RemoveComp_OnClick"/>
                        </Grid>
                    </Grid>
                    
                    <Border Grid.Row="1" Classes="Statusbar">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="4 0 0 0" HorizontalAlignment="Left">
                                <Button Content="Cancel" Margin="0 4" Width="64" Click="CancelButton_OnClick" />
                                <Button Content="&lt;&lt; Project setup" Margin="0 4" Click="ProjectSetupButton_OnClick" />
                            </StackPanel>
                            <Button Content="Save task" Margin="0 4 4 4" Width="96" HorizontalAlignment="Right" Click="SaveTaskButton_OnClick" 
                                    IsVisible="{Binding IsEditing}"/>
                            <Button Content="Create task" Margin="0 4 4 4" Width="96" HorizontalAlignment="Right" Click="SaveTaskButton_OnClick" 
                                    IsVisible="{Binding !IsEditing}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Carousel>    
        </Grid>
    </Grid>
</Window>
